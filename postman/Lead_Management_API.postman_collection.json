            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Postman Lead Full Update\",\n  \"phone\": \"9876543210\",\n  \"whatsapp_number\": \"9876543210\",\n  \"email\": \"postman.updated@example.com\",\n  \"company_name\": \"Acme Retail Pvt Ltd\",\n  \"designation\": \"Director\",\n  \"source\": \"referral\",\n  \"priority\": \"hot\",\n  \"assigned_to\": {{employee_id}},\n  \"status\": \"contacted\",\n  \"tags\": \"retail,updated\",\n  \"address\": \"Andheri East\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"pincode\": \"400069\",\n  \"notes\": \"Full update from Postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/leads/{{lead_id}}/", "description": "Full lead update example. This also records status history when the status changes."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Lead fully updated', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('contacted');"] } }],
          "response": [{
