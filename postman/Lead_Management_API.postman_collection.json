            "status": "Not Found", "code": 404, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"detail\": \"No Lead matches the given query.\"\n}"
          }]
        },
        {
          "name": "PATCH Lead",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Postman Lead Updated\",\n  \"phone\": \"9876543210\",\n  \"priority\": \"warm\",\n  \"assigned_to\": {{employee_id}},\n  \"notes\": \"Updated through PATCH\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/leads/{{lead_id}}/", "description": "Updates a lead. Include full_name and phone in the current API implementation. Converted/lost transitions require dedicated actions."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Lead patched', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().priority).to.eql('warm');"] } }],
          "response": [{
            "name": "200 - Lead Updated", "originalRequest": { "method": "PATCH", "url": "{{base_url}}/leads/12/" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
