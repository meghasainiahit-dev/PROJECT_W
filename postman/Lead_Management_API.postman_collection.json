          }]
        }
      ]
    },
    {
      "name": "04 - Lead Actions",
      "item": [
        {
          "name": "Change Lead Status",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"qualified\",\n  \"reason\": \"Customer requirements verified\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/leads/{{lead_id}}/status/", "description": "Allowed regular statuses: new, contacted, follow_up, interested, qualified, proposal_sent, negotiation, not_interested, not_responding. Use dedicated convert/mark-lost endpoints for terminal statuses."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status changed', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('qualified');"] } }],
          "response": [{
            "name": "200 - Status Changed", "originalRequest": { "method": "POST", "url": "{{base_url}}/leads/12/status/" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"id\": 12,\n  \"lead_id\": \"LEAD-00012\",\n  \"status\": \"qualified\",\n  \"status_display\": \"Qualified\",\n  \"activities\": [{\"event\": \"status_changed\", \"title\": \"Status Changed\", \"description\": \"Contacted → Qualified\"}]\n}"
          }]
        },
        {
          "name": "Add Lead Note",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Customer requested the revised price list.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/leads/{{lead_id}}/note/", "description": "Adds an immutable timeline note to the lead."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Note added', () => pm.response.to.have.status(201));", "pm.expect(pm.response.json().note).to.be.a('string');"] } }],
          "response": [{
            "name": "201 - Note Added", "originalRequest": { "method": "POST", "url": "{{base_url}}/leads/12/note/" },
            "status": "Created", "code": 201, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"id\": 7,\n  \"note\": \"Customer requested the revised price list.\",\n  \"created_at\": \"2026-09-02T11:00:00+05:30\"\n}"
          }]
        },
        {
          "name": "Add Follow-up and Save ID",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"follow_up_date\": \"{{follow_up_date}}\",\n  \"follow_up_time\": \"15:30\",\n  \"follow_up_type\": \"demo\",\n  \"notes\": \"Online product demonstration\",\n  \"assigned_to\": {{employee_id}}\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/leads/{{lead_id}}/follow-up/", "description": "Schedules a call, whatsapp, email, meeting or demo. The response id is saved as follow_up_id."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Follow-up created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.collectionVariables.set('follow_up_id', String(json.id));"] } }],
          "response": [{
            "name": "201 - Follow-up Added", "originalRequest": { "method": "POST", "url": "{{base_url}}/leads/12/follow-up/" },
            "status": "Created", "code": 201, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"id\": 9,\n  \"lead_id\": 12,\n  \"follow_up_date\": \"2026-09-05\",\n  \"follow_up_time\": \"15:30\",\n  \"follow_up_type\": \"demo\",\n  \"follow_up_type_display\": \"Demo\",\n  \"status\": \"upcoming\",\n  \"status_display\": \"Upcoming\",\n  \"notes\": \"Online product demonstration\",\n  \"assigned_to\": 4,\n  \"assigned_to_name\": \"Sales User\"\n}"
          }]
        },
        {
          "name": "Convert Lead",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"conversion_date\": \"{{today}}\",\n  \"product_service\": \"Stock Management Setup\",\n  \"deal_amount\": \"125000.00\",\n  \"payment_status\": \"partial\",\n  \"notes\": \"Purchase order received\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/leads/{{lead_id}}/convert/", "description": "Converts the primary test lead and records conversion details. Payment status: pending, partial or paid."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Lead converted', () => pm.response.to.have.status(201));", "pm.expect(pm.response.json().lead.status).to.eql('converted');"] } }],
          "response": [{
            "name": "201 - Lead Converted", "originalRequest": { "method": "POST", "url": "{{base_url}}/leads/12/convert/" },
            "status": "Created", "code": 201, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"id\": 3,\n  \"lead\": {\n    \"id\": 12,\n    \"lead_id\": \"LEAD-00012\",\n    \"status\": \"converted\",\n    \"status_display\": \"Converted\",\n    \"conversion\": {\n      \"conversion_date\": \"2026-09-02\",\n      \"product_service\": \"Stock Management Setup\",\n      \"deal_amount\": \"125000.00\",\n      \"payment_status\": \"partial\",\n      \"notes\": \"Purchase order received\",\n      \"converted_by\": 1\n    }\n  }\n}"
          }]
        },
        {
          "name": "Create Separate Lead for Lost Flow",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Postman Lost Lead {{unique_suffix}}\",\n  \"phone\": \"9123456780\",\n  \"source\": \"cold_call\",\n  \"priority\": \"cold\",\n  \"status\": \"new\",\n  \"notes\": \"Separate record for lost flow\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/leads/", "description": "Creates a separate lead so the mark-lost example does not overwrite the converted lead."
