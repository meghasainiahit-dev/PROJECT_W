{
  "info": {
    "_postman_id": "6d3e76c7-7b5d-4edc-a101-109a0dd7d746",
    "name": "StockOS - Lead Management APIs",
    "description": "Complete Lead Management API collection with request bodies, response examples, tests and automatic variables. Set base_url, username and password, then run folders in order. Login saves token; lead creation saves lead_id; follow-up creation saves follow_up_id. The access user must have Lead Management permissions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const pad = n => String(n).padStart(2, '0');",
          "const formatDate = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
          "const now = new Date();",
          "const future = new Date(now); future.setDate(now.getDate() + 3);",
          "pm.collectionVariables.set('today', formatDate(now));",
          "pm.collectionVariables.set('follow_up_date', formatDate(future));",
          "if (!pm.collectionVariables.get('unique_suffix')) pm.collectionVariables.set('unique_suffix', String(Date.now()));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://stms.testwebs.in/api", "type": "string" },
    { "key": "username", "value": "admin", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "employee_id", "value": "", "type": "string" },
    { "key": "lead_id", "value": "", "type": "string" },
    { "key": "lost_lead_id", "value": "", "type": "string" },
    { "key": "follow_up_id", "value": "", "type": "string" },
    { "key": "today", "value": "", "type": "string" },
    { "key": "follow_up_date", "value": "", "type": "string" },
    { "key": "unique_suffix", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login and Save Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/app/login/",
            "description": "Authenticates the user. The test script saves the 7-day JWT into collection variable token. The returned user.modules must contain leads and action_permissions.leads controls view/add/edit/delete."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Login successful', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.token).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('token', json.token);",
              "pm.test('Lead module access present', () => pm.expect(json.user.modules).to.include('leads'));"
            ] }
          }],
          "response": [
            {
              "name": "200 - Login Success",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"********\"\n}" }, "url": "{{base_url}}/app/login/" },
              "status": "OK", "code": 200, "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
              "body": "{\n  \"token\": \"eyJ...jwt-token...\",\n  \"user\": {\n    \"id\": 1,\n    \"username\": \"admin\",\n    \"name\": \"Administrator\",\n    \"email\": \"admin@example.com\",\n    \"role\": \"super_admin\",\n    \"role_display\": \"Super Admin\",\n    \"modules\": [\"dashboard\", \"leads\"],\n    \"action_permissions\": {\"leads\": [\"view\", \"add\", \"edit\", \"delete\"]},\n    \"module_catalog\": [{\"key\": \"leads\", \"label\": \"Lead Management\"}],\n    \"actions\": [\"view\", \"add\", \"edit\", \"delete\"]\n  }\n}"
            },
            {
              "name": "400 - Invalid Credentials",
              "originalRequest": { "method": "POST", "url": "{{base_url}}/app/login/" },
              "status": "Bad Request", "code": 400, "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
              "body": "{\n  \"message\": \"Invalid username or password.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Reference Data and Dashboard",
      "item": [
        {
          "name": "Get Lead Options and Save Employee",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/leads/options/",
            "description": "Returns all dropdown options and active employees. The first employee id is saved automatically."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Options returned', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.expect(json.statuses).to.be.an('array').that.is.not.empty;",
            "if (json.employees && json.employees.length) pm.collectionVariables.set('employee_id', String(json.employees[0].id));"
          ] } }],
          "response": [{
            "name": "200 - Options", "originalRequest": { "method": "GET", "url": "{{base_url}}/leads/options/" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"statuses\": [{\"value\": \"new\", \"label\": \"New\"}, {\"value\": \"converted\", \"label\": \"Converted\"}],\n  \"priorities\": [{\"value\": \"hot\", \"label\": \"Hot\"}],\n  \"sources\": [{\"value\": \"website\", \"label\": \"Website\"}],\n  \"lost_reasons\": [{\"value\": \"budget_issue\", \"label\": \"Budget Issue\"}],\n  \"follow_up_types\": [{\"value\": \"call\", \"label\": \"Call\"}],\n  \"follow_up_statuses\": [{\"value\": \"upcoming\", \"label\": \"Upcoming\"}],\n  \"payment_statuses\": [{\"value\": \"pending\", \"label\": \"Pending\"}],\n  \"employees\": [{\"id\": 4, \"name\": \"Sales User\", \"username\": \"sales\"}]\n}"
          }]
        },
        {
          "name": "Get Lead Statistics",
          "request": { "method": "GET", "url": "{{base_url}}/leads/stats/", "description": "Lead totals, conversion rate and follow-up counters." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Stats returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.property('conversion_rate');"] } }],
          "response": [{
            "name": "200 - Statistics", "originalRequest": { "method": "GET", "url": "{{base_url}}/leads/stats/" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"total\": 24,\n  \"new\": 4,\n  \"active\": 16,\n  \"converted\": 5,\n  \"lost\": 3,\n  \"follow_ups_today\": 2,\n  \"overdue_follow_ups\": 1,\n  \"conversion_rate\": 20.8\n}"
          }]
        }
      ]
    },
    {
      "name": "03 - Lead CRUD",
      "item": [
        {
          "name": "Create Lead and Save ID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Postman Lead {{unique_suffix}}\",\n  \"phone\": \"9876543210\",\n  \"whatsapp_number\": \"9876543210\",\n  \"email\": \"postman.{{unique_suffix}}@example.com\",\n  \"company_name\": \"Acme Retail\",\n  \"designation\": \"Purchase Manager\",\n  \"source\": \"website\",\n  \"priority\": \"hot\",\n  \"assigned_to\": {{employee_id}},\n  \"status\": \"new\",\n  \"tags\": \"retail,high-value\",\n  \"address\": \"MG Road\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"pincode\": \"400001\",\n  \"notes\": \"Created from Postman collection\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/leads/",
            "description": "Creates the primary test lead. full_name and phone are required. Use dedicated endpoints for converted/lost status."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lead created', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('lead_id', String(json.id));",
            "pm.expect(json.lead_id).to.match(/^LEAD-/);"
          ] } }],
          "response": [{
            "name": "201 - Lead Created", "originalRequest": { "method": "POST", "url": "{{base_url}}/leads/" },
            "status": "Created", "code": 201, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"id\": 12,\n  \"lead_id\": \"LEAD-00012\",\n  \"full_name\": \"Postman Lead\",\n  \"phone\": \"9876543210\",\n  \"whatsapp_number\": \"9876543210\",\n  \"email\": \"postman@example.com\",\n  \"company_name\": \"Acme Retail\",\n  \"designation\": \"Purchase Manager\",\n  \"source\": \"website\",\n  \"source_display\": \"Website\",\n  \"priority\": \"hot\",\n  \"priority_display\": \"Hot\",\n  \"assigned_to\": 4,\n  \"assigned_to_name\": \"Sales User\",\n  \"status\": \"new\",\n  \"status_display\": \"New\",\n  \"tags\": [\"retail\", \"high-value\"],\n  \"next_follow_up\": null,\n  \"activities\": [{\"id\": 31, \"event\": \"created\", \"title\": \"Lead Created\"}],\n  \"follow_ups\": [],\n  \"lead_notes\": [],\n  \"created_at\": \"2026-09-02T10:30:00+05:30\",\n  \"updated_at\": \"2026-09-02T10:30:00+05:30\"\n}"
          }, {
            "name": "400 - Validation Error", "originalRequest": { "method": "POST", "url": "{{base_url}}/leads/" },
            "status": "Bad Request", "code": 400, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"detail\": \"Please correct the highlighted fields.\",\n  \"errors\": {\"full_name\": \"Full name is required.\", \"phone\": \"Phone number is required.\"}\n}"
          }]
        },
        {
          "name": "List and Filter Leads",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/leads/?search=Postman&status=new&priority=hot&source=website&assigned_to={{employee_id}}&view=all&sort=-created_at&page=1&page_size=25", "host": ["{{base_url}}"], "path": ["leads", ""], "query": [
              { "key": "search", "value": "Postman" }, { "key": "status", "value": "new" }, { "key": "priority", "value": "hot" }, { "key": "source", "value": "website" }, { "key": "assigned_to", "value": "{{employee_id}}" }, { "key": "view", "value": "all" }, { "key": "sort", "value": "-created_at" }, { "key": "page", "value": "1" }, { "key": "page_size", "value": "25" }, { "key": "date_from", "value": "2026-01-01", "disabled": true }, { "key": "date_to", "value": "{{today}}", "disabled": true }
            ] },
            "description": "Paginated list. Optional filters are editable in Params. page_size range is 1-100."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Lead list returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().results).to.be.an('array');"] } }],
          "response": [{
            "name": "200 - Paginated Leads", "originalRequest": { "method": "GET", "url": "{{base_url}}/leads/?page=1&page_size=25" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"count\": 1,\n  \"page\": 1,\n  \"pages\": 1,\n  \"results\": [{\n    \"id\": 12,\n    \"lead_id\": \"LEAD-00012\",\n    \"full_name\": \"Postman Lead\",\n    \"phone\": \"9876543210\",\n    \"status\": \"new\",\n    \"status_display\": \"New\",\n    \"priority\": \"hot\",\n    \"priority_display\": \"Hot\",\n    \"next_follow_up\": null\n  }]\n}"
          }]
        },
        {
          "name": "Get Lead Detail",
          "request": { "method": "GET", "url": "{{base_url}}/leads/{{lead_id}}/", "description": "Returns the complete lead with activities, follow-ups, notes and conversion when available." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Lead detail returned', () => pm.response.to.have.status(200));", "pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('lead_id'));"] } }],
          "response": [{
            "name": "200 - Lead Detail", "originalRequest": { "method": "GET", "url": "{{base_url}}/leads/12/" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"id\": 12,\n  \"lead_id\": \"LEAD-00012\",\n  \"full_name\": \"Postman Lead\",\n  \"phone\": \"9876543210\",\n  \"status\": \"new\",\n  \"status_display\": \"New\",\n  \"priority\": \"hot\",\n  \"activities\": [{\"id\": 31, \"event\": \"created\", \"title\": \"Lead Created\", \"created_at\": \"2026-09-02T10:30:00+05:30\"}],\n  \"follow_ups\": [],\n  \"lead_notes\": [],\n  \"next_follow_up\": null\n}"
          }, {
